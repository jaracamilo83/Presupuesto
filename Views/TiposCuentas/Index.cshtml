@model IEnumerable<TipoCuenta>
@{
    ViewData["Title"] = "Tipos Cuentas";
}

<h3>Tipos de cuentas bancarias</h3>
@if (ViewBag.Error != null)
{
    <div class="alert text-danger" role="alert">
        <p>@ViewBag.Error</p>
    </div>
}

<a class="btn btn-primary mb-3" asp-action="Crear" asp-controller="TiposCuentas">Crear</a>

<div class="container">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Acciones</th>    
            </tr>
        </thead>
        <tbody>
        @foreach (var tiposCuentas in Model)
        {
            <tr>
                <td>@tiposCuentas.Nombre</td>
                <td>
                    <a class="btn btn-info" asp-action="Editar" asp-route-tipoCuentaId="@tiposCuentas.Id">Editar</a>
                    <a class="btn btn-danger" onclick="EliminarTipoCuenta(@tiposCuentas.Id)">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>